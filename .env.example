DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.c-11.us-east-1.aws.neon.tech:5432/DATABASE?sslmode=require&channel_binding=require
# Managed Neon Auth (public endpoints — no secrets). JWKS/issuer derive from BASE_URL when unset.
NEON_AUTH_BASE_URL=https://HOST.neonauth.c-11.us-east-1.aws.neon.tech/DATABASE/auth
NEON_AUTH_JWKS_URL=https://HOST.neonauth.c-11.us-east-1.aws.neon.tech/DATABASE/auth/.well-known/jwks.json
# Comma-separated CORS allow-list; unset falls back to http://localhost:8000.
CORS_ORIGIN=https://your-frontend.example.com,http://localhost:8000
